// excel工具配置
{
    // ds文件生成配置 -- DataScriptGeneratorCfg
    dsGenerator: {
        // outPath: "", 
        // templateFile = "",
        items: [
            {
                 name: ItemCfg,
                 extraFields: [
                    {name: cacheLv, type: int32, comment: "额外缓存字段"}
                 ]
            }
        ]
    },
    // dson文本生成器配置 -- DsonGeneratorCfg
    dsonGenerator: {
        // outPath: "", 
        enableText: true,
        enableBinary: true,
    },
    
    // class生成配置 -- CodeGeneratorCfg
    classGenerator: {
        // outPath: "", 
        codecProxyNs: "Wjybxx.BigCat.Demo",
        codecCfgs: [
            {
                name: ItemCfg,
                proxy: ItemCodecProxy,
                fieldProxies: [
                    {name: level, readProxy: ReadLevel, writeProxy: WriteLevel}   
                ],
                hooks: {
                    AfterDecode: AfterDecode
                }
            }
        ]
    },
    // 常量类生成配置 -- ConstGeneratorCfg
    constGenerator: {
        // outPath: "",
        ns: "Wjybxx.BigCat.Demo",
        items: [
            {clsName: SkillConst, sheetName: SkillParam}, 
            {clsName: ItemConst, sheetName: Item, nameCol: enumName, valueCol: itemId, commentCol: desc}
        ],
    }
}