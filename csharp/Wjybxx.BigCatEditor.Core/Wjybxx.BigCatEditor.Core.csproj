<Project Sdk="Microsoft.NET.Sdk">


    <PropertyGroup>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>annotations</Nullable>
        <LangVersion>9</LangVersion> <!-- 为兼容unity我们使用c#9 -->
        <RootNamespace>Wjybxx.BigCatEditor</RootNamespace>

        <AssemblyName>Wjybxx.BigCatEditor.Core</AssemblyName>
        <PackageId>Wjybxx.BigCatEditor.Core</PackageId>
        <PackageVersion>1.0.0</PackageVersion>

        <Title>Wjybxx.BigCatEditor.Core</Title>
        <Description>Editor工具公共包</Description>
        <PackageTags>wjybxx;bigcat;</PackageTags>

        <Authors>wjybxx(845740757@qq.com)</Authors>
        <Owners>wjybxx(845740757@qq.com)</Owners>
        <Copyright>Copyright 2023-2024 wjybxx(845740757@qq.com)</Copyright>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
        <PackageProjectUrl>https://github.com/hl845740757/BigCat</PackageProjectUrl>
        <PackageReleaseNotes>https://github.com/hl845740757/BigCat/releases</PackageReleaseNotes>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <NeutralLanguage>zh-Hans</NeutralLanguage>

        <PackageReadmeFile>README.md</PackageReadmeFile>
        <EmbedAllSources>true</EmbedAllSources> <!-- 嵌入源代码 -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <TargetFrameworks>net6.0;net7.0;net8.0;</TargetFrameworks>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
        <NoWarn>1701;1702;1591;8632;0419</NoWarn>
    </PropertyGroup>

    <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
        <NoWarn>1701;1702;1591;8632;0419</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Wjybxx.Commons.Apt" Version="1.3.0" />
        <PackageReference Include="Wjybxx.Commons.Concurrent" Version="1.3.0" />
        <PackageReference Include="Wjybxx.Commons.Core" Version="1.3.0" />
        <PackageReference Include="Wjybxx.Commons.Inject" Version="1.0.0" />
        <PackageReference Include="Wjybxx.Dson.Codec" Version="2.4.0" />
        <PackageReference Include="Wjybxx.Dson.Core" Version="2.4.0" />
    </ItemGroup>

</Project>
