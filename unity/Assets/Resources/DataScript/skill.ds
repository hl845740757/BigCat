// 技能配置文件示例
import public "common.ds";
import public "btree.ds";

// 伤害类型
enum DamageType {
  Physic = 0;
  Magic = 1;
}

// 元素类型
enum ElementType {
  None = 0;
  Ice =  1;
  Fire = 2;
  Light = 3;
  Dark = 4;
}

// 执行伤害 - T为黑板类型，末尾统一指定
class ActionDamage<T> : LeafTask<T> {
  DamageType dmgType = 1;
  ElementType eleType = 2;
  float attck = 3; // 攻击力系数
  List<MinMaxAABB> hitBoxes = 4; // 攻击盒
}
// 添加Buff
class ActionBuff<T> : LeafTask<T> {
  int32 buffId = 1;
  int32 buffLV = 2; // buff等级
  float duration = 3; // 持续时间
  int32 initStack = 4; // 初始层数
}

// 这里将所有类型引用进来，通过子类实例化泛型
class SkillGroupEntry0<T> : BTreeSearchTreeGroupEntry0<T> {
  ActionDamage<T> _f1 = 1;
  ActionBuff<T> _f2 = 2;
}
// 通过子类直接实例化所有泛型
// @SearchTreeGroupEntry {}
class SkillGroupEntry : SkillGroupEntry0<Object> {
}