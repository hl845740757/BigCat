// 公共类型定义

// @Options{ alias: [Vector2, V2], encodeFeatures: "Double4AsVector | Double4Len2" }
// @Editor{ displayType: Vector2, dsonType: Double4 }
struct Vector2 {
    float x = 1;
    float y = 2;
}
// @Options{ alias: [Vector3, V3], encodeFeatures: "Double4AsVector | Double4Len3" }
// @Editor{ displayType: Vector3, dsonType: Double4 }
struct Vector3 {
    float x = 1;
    float y = 2;
    float z = 3;
}
// @Options{ alias: [Vector4, V4], encodeFeatures: "Double4AsVector" }
// @Editor{ displayType: Vector4, dsonType: Double4 }
struct Vector4 {
    float x = 1;
    float y = 2;
    float z = 3;
    float w = 4;
}
// @Options{ alias: [Quaternion, Quat], encodeFeatures: "Double4AsVector" }
// @Editor{ displayType: Vector4, dsonType: Double4 }
struct Quaternion {
    float x = 1;
    float y = 2;
    float z = 3;
    float w = 4;
}
// @Options{ alias: [Vector2Int, VInt2], encodeFeatures: "Double4AsVector | Double4AsInt | Double4Len2" }
// @Editor{ displayType: Vector2Int, dsonType: Double4 }
struct Vector2Int {
    int32 x = 1;
    int32 y = 2;
}
// @Options{ alias: [Vector3Int, VInt3], encodeFeatures: "Double4AsVector | Double4AsInt | Double4Len3" }
// @Editor{ displayType: Vector3Int, dsonType: Double4 }
struct Vector3Int {
    int32 x = 1;
    int32 y = 2;
    int32 z = 3;
}

// @Options{ encodeFeatures: "Double4AsRgba" }
// @Editor { displayType : Color, dsonType: Double4 }
struct Color {
  float r = 1;
  float g = 2;
  float b = 3;
  float a = 4;
}
// @Options{ style: flow }
// @Editor { displayType : Color32 }
struct Color32 {
  int32 rgba = 1;
}
// @Options{ style: flow }
// @Editor { displayType : Euler32 }
struct Euler32 {
  int32 xyz = 1;
}

// @Options{ style: flow }
// @Editor { displayType : ObjectPath, dsonType: Pointer }
struct ObjectPath {
	string colletion = 1;
	string localPath = 2;
	int64 localId = 3;
	int32 type = 4;
}
// @Options{ style: flow }
// @Editor { displayType : MinMaxAABB }
struct MinMaxAABB {
  Vector3 min = 1;
  Vector3 max = 2;
}

// 枚举Set
// @Editor{ displayType: EnumSet, dsonType: Array }
class EnumSet<T> {
  List<int32> values = 1; // 所有元素
}