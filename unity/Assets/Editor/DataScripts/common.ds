// 公共类型定义

// 文件选项
option {
  macro_types: [region, endregion],
}

// ---------------------------------------------------------
// @Namespace{cs: "UnityEngine"}
// @Options{ alias: [Vector2, V2], encodeFeatures: "Double4AsVector | Double4Len2" }
// @Editor{ displayType: Vector2, dsonType: Double4 }
struct Vector2 {
    float x = 1;
    float y = 2;
}
// @Namespace{cs: "UnityEngine"}
// @Options{ alias: [Vector3, V3], encodeFeatures: "Double4AsVector | Double4Len3" }
// @Editor{ displayType: Vector3, dsonType: Double4 }
struct Vector3 {
    float x = 1;
    float y = 2;
    float z = 3;
}
// @Namespace{cs: "UnityEngine"}
// @Options{ alias: [Vector4, V4], encodeFeatures: "Double4AsVector" }
// @Editor{ displayType: Vector4, dsonType: Double4 }
struct Vector4 {
    float x = 1;
    float y = 2;
    float z = 3;
    float w = 4;
}
// @Namespace{cs: "UnityEngine"}
// @Options{ alias: [Quaternion, Quat], encodeFeatures: "Double4AsVector" }
// @Editor{ displayType: Vector4, dsonType: Double4 }
struct Quaternion {
    float x = 1;
    float y = 2;
    float z = 3;
    float w = 4;
}
// @Namespace{cs: "UnityEngine"}
// @Options{ alias: [Vector2Int, VInt2], encodeFeatures: "Double4AsVector | Double4AsInt | Double4Len2" }
// @Editor{ displayType: Vector2Int, dsonType: Double4 }
struct Vector2Int {
    int32 x = 1;
    int32 y = 2;
}
// @Namespace{cs: "UnityEngine"}
// @Options{ alias: [Vector3Int, VInt3], encodeFeatures: "Double4AsVector | Double4AsInt | Double4Len3" }
// @Editor{ displayType: Vector3Int, dsonType: Double4 }
struct Vector3Int {
    int32 x = 1;
    int32 y = 2;
    int32 z = 3;
}
// @Namespace{cs: "UnityEngine"}
// @Options{ encodeFeatures: "Double4AsArray" }
// @Editor{ displayType: Rect, dsonType: Double4 }
struct Rect {
  float x = 1;
  float y = 2;
  float w = 3;
  float h = 4;
}
// @Namespace{cs: "UnityEngine"}
// @Options{ encodeFeatures: "Double4AsArray | Double4AsInt" }
// @Editor{ displayType: RectInt, dsonType: Double4 }
struct RectInt {
  int32 x = 1;
  int32 y = 2;
  int32 w = 3;
  int32 h = 4;
}

// @Namespace{cs: "UnityEngine"}
// @Options{ encodeFeatures: "Double4AsRgba" }
// @Editor { displayType : Color, dsonType: Double4 }
struct Color {
  float r = 1;
  float g = 2;
  float b = 3;
  float a = 4;
}
// Color32编辑器下输出为4个整数的可维护性更好，Euler32同理 - 二进制下也不会占用太多开销
// @Namespace{cs: "UnityEngine"}
// @Options{ style: flow, encodeFeatures: "Double4AsRgba | Double4AsInt"  }
// @Editor { displayType : Color32, dsonType: Double4 }
struct Color32 {
  int32 r = 1;
  int32 g = 2;
  int32 b = 3;
  int32 a = 4;
}
// @Namespace{cs: "Wjybxx.BigCat.Core"}
// @Options{ style: flow, encodeFeatures: "Double4AsVector | Double4AsInt | Double4Len3" }
// @Editor { displayType : Euler32 }
struct Euler32 {
  int32 x = 1;
  int32 y = 2;
  int32 z = 3;
}
// @Namespace{cs: "Wjybxx.BigCat.Core"}
// @Editor { displayType : MinMaxAABB }
struct MinMaxAABB {
  Vector3 min = 1;
  Vector3 max = 2;
}
// @Namespace{cs: "Wjybxx.Commons"}
// @Options{ style: flow }
// @Editor { displayType : ObjectPath, dsonType: Pointer }
struct ObjectPath {
	string colletion = 1;
	string localPath = 2;
	int32 localId = 3;
	int32 type = 4;
}

// 不可变内置集合
// @Namespace{cs: "Wjybxx.Commons.Collections"}
class ImmutableList<T> : List<T> {
}
// @Namespace{cs: "Wjybxx.Commons.Collections"}
class ImmutableSet<T> : HashSet<T> {
}
// @Namespace{cs: "Wjybxx.Commons.Collections"}
class ImmutableMap<K,V> : Map<K, V> {
}
// ArrayMap
// @Namespace{cs: "Wjybxx.Commons.Collections"}
class ArrayMap<K,V> : Map<K, V> {
}

// Dson类型 - 只能用于Port字段
// @Namespace{cs: "Wjybxx.Dson"}
class DsonValue {
}
// @Namespace{cs: "Wjybxx.Dson"}
class DsonObject<Key> : DsonValue {
}
// @Namespace{cs: "Wjybxx.Dson"}
class DsonArray<Key> : DsonValue {
}

// 枚举Set
// @Namespace{cs: "Wjybxx.BigCat.Util"}
// @Editor{ displayType: EnumSet, dsonType: Array }
class EnumSet<T> {
  List<int32> values = 1; // 所有元素
}
// 64位枚举Set
// @Namespace{cs: "Wjybxx.BigCat.Util"}
// @Editor{ displayType: EnumSet64 }
class EnumSet64<T> {
  int32 lowBits = 1;
  int32 highBits = 2;
}