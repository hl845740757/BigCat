// 打包工具
import public "common.ds";
import public "btree.ds";

// 收集器类型
enum ECollectorType {
  MainAsset = 0;
  DependBundle = 1;
  DependAsset = 2;
  RawFile = 3;
}
// 分组方式
enum EGroupBy {
  Directory = 0; 
  Collector = 1; 
}
// @Options{ isFlags: true }
enum EAssetIndexes {
    FileName = 1; // 文件名索引
    FolderAndFileName = 2; // 文件夹+文件名索引
    FolderAndFileNamePlus = 3; // 文件夹+文件名索引，支持指定深度
    RelativeToCollector = 4; // 相对收集器的路径
}

// 构建平台
enum EBuildTarget {
  NoTarget = -2;
  StandaloneOSX = 2;
  StandaloneWindows = 5;
  iOS = 9;
  Android = 13;
  StandaloneWindows64 = 19;
  WebGL = 20;
  PS4 = 31;
  XboxOne = 33;
  Switch = 38;
  GameCoreXboxSeries = 42;
  GameCoreXboxOne = 43;
  PS5 = 44;
}
// 压缩方式
enum ECompression {
  None = 0;
  LZMA = 1;
  LZ4 = 2;
}

// 工具库的黑板类型，避免导出给其它ds文件
// @Namespace{ cs: "Wjybxx.BigCat.Util", nonGenerate: true }
class Blackboard  {
}
// 分类工具
class IAssetClassifier {
}
// 忽略规则服务
class IIgnoreService {
}

// 收集器 - ds文件中直接继承Task类，以屏蔽children/child属性
class Collector : Task<Blackboard> {
  //@Editor {displayType: AssetPath, isFolder: true}
  string collectPath = 1; // 扫描开始目录
  bool recursive = 2; // 是否递归
  ECollectorType collectorType = 3;
  
  EGroupBy groupBy = 5; // 分组方式
  int32 groupDepth = 6; // 分组深度
  HashSet<string> bundleTags = 7;
  EAssetIndexes assetIndexes = 8;
  int32 indexDepth = 9; // 索引深度，大于1才有效
  
  // @PortField{side: right}
  IAssetClassifier classifier = 10;
}
inst Collector {
  recursive: true,
  groupDepth: 1,
  assetIndexes: 1
}

// 收集器组
class CollectorGroup : Task<Blackboard> {
  bool enabled = 1; // 启用状态
  HashSet<string> bundleTags = 2;
  
  // @PortField{side: right}
  List<Collector> collectors = 3; // 收集器
  // @PortField{side: right}
  List<Task<Blackboard>> preTasks = 4; // 预处理任务
  // @PortField{side: right}
  IAssetClassifier classifier = 5;
}
inst CollectorGroup {
  enabled: true
}

// 包收集器
class CollectorPackage : Task<Blackboard> {
  string packageName = 1; // 资源包名字
  string packageVersion = 2; // 资源包版本
  bool useAssetDependencyDB = 3; // 是否启用缓存db
  // @PortField{side: right}
  List<CollectorGroup> collectorGroups = 4; // 收集器组
}
inst CollectorPackage {
  packageName: Default,
  packageVersion: "0.0.0",
  useAssetDependencyDB: true
}

// 构建管线 - ds文件中直接继承Task类，以屏蔽children属性
class BuildPipelineTask : Task<Blackboard> {
  EBuildTarget buildTarget = 1; // 构建目标
  ECompression compression = 2; // 压缩方式
  
  // @PortField{side: bottom}
  List<Task<Blackboard>> preBuildTasks = 6; // 构建前任务
  // @PortField{side: bottom}
  List<Task<Blackboard>> buildTasks = 7; // 构建任务
  // @PortField{side: bottom}
  List<Task<Blackboard>> postBuildTasks = 8; // 构建后任务
}

// 包构建器入口
class PackageBuilder {
  // @PortField{side: right}
  CollectorPackage package = 1;
  // @PortField{side: right}
  BuildPipelineTask buildTask = 2;
}

// 编辑器下的构建任务
class EditorBuildTask : Task<Blackboard> {
  //@Editor {displayType: AssetPath}
  string binFilePath = 1;
  //@Editor {displayType: AssetPath}
  string textFilePath = 2; 
}
// 图片分类器
class SpriteClassifier {
}

// 导入SearchWindow
// @SearchTreeGroupEntry {}
class SkillGroupEntry : BTreeSearchTreeGroupEntry0<Blackboard> {
  Collector _f1 = 1;
  CollectorGroup _f2 = 2;
  CollectorPackage _f3 = 3;
  BuildPipelineTask _f4 = 4;
  PackageBuilder _f5 = 5; //@Editor{nodeFeatures: "Executable | EnablePort" }
  EditorBuildTask _f6 = 6;
  SpriteClassifier _f7 = 7;
}