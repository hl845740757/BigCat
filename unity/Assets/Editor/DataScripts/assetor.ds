// 打包工具
import public "common.ds";
import public "btree.ds";

// 文件选项
option {
  macro_types: [region, endregion],
}

// ---------------------------------------------------------
// 工具库的黑板类型，避免导出给其它ds文件
// @Namespace{ cs: "Wjybxx.BigCat.Util", nonGenerate: true }
class Blackboard  {
}

// 收集器类型
enum ECollectorType {
  MainAsset = 0;
  DependBundle = 1;
  DependAsset = 2;
  RawFile = 3;
}
// 分组方式
enum EGroupBy {
  Directory = 0; 
  Collector = 1; 
}
// @Options{isFlags: true, encodeFeatures: EnumAsString}
enum EAssetIndexes {
  None = 0; // 无
  FileName = 0x01; // 文件名索引
  FolderAndFileName = 0x02; // 文件夹+文件名索引
  RelativeToAncestor = 0x04; // 相对指定祖先的路径
  RelativeToCollector = 0x08; // 相对收集器的路径
  TypeAndFileName = 0x10; // 类型名+文件名（无后缀）
  TypeAndFolderName = 0x20; // 类型名+文件夹+文件名（无后缀）
}

// 构建平台
enum EBuildTarget {
  NoTarget = -2;
  StandaloneOSX = 2;
  StandaloneWindows = 5;
  IOS = 9;
  Android = 13;
  StandaloneWindows64 = 19;
  WebGL = 20;
  PS4 = 31;
  XboxOne = 33;
  Switch = 38;
  GameCoreXboxSeries = 42;
  GameCoreXboxOne = 43;
  PS5 = 44;
}
// 压缩方式
enum ECompression {
  None = 0;
  LZMA = 1;
  LZ4 = 2;
}

// 分类工具
class IAssetClassifier {
}
// 忽略规则服务
class IIgnoreService {
}

// 收集器 - ds文件中直接继承Task类，以屏蔽children/child属性
class Collector : Task<Blackboard> {
  string collectPath = 1; // 扫描开始目录 @Editor{displayType: AssetPath, isFolder: true}
  bool recursive = 2; // 是否递归
  ECollectorType collectorType = 3;
  bool provided = 4; // 是否不参与最终打包
  
  EGroupBy groupBy = 5; // 分组方式
  int32 groupDepth = 6; // 分组深度
  HashSet<string> bundleTags = 7; // 自定义标签
  EAssetIndexes assetIndexes = 8; // 普通索引
  EAssetIndexes uniqueIndexes = 9; // 唯一索引
  string ancestorPath = 10; // 祖先节点路径  @Editor{displayType: AssetPath}
  // @Candidates[Sprite, Texture2D, AudioClip, VideoClip]
  HashSet<string> noIndexTypes = 11; // 不需要建立索引的资产对象类型
  
  // @PortField{side: right}
  IAssetClassifier classifier = 12; // 文件分类器
}
inst Collector {
  recursive: true,
  groupDepth: 1,
  assetIndexes: 0,
  uniqueIndexes: 0,
  indexDepth: 2
}

// 收集器组
class CollectorGroup : Task<Blackboard> {
  bool enabled = 1; // 启用状态
  HashSet<string> bundleTags = 2; // 会合并到Collector

  // @PortField{side: right}
  List<Task<Blackboard>> preTasks = 3; // 预处理任务
  // @PortField{side: right}
  List<Collector> collectors = 4; // 收集器
  // @PortField{side: right}
  IAssetClassifier classifier = 5; // 资产分类器
}
inst CollectorGroup {
  enabled: true
}

// 包收集器
class CollectorPackage : Task<Blackboard> {
  string packageName = 1; // 资源包名字
  string packageVersion = 2; // 资源包版本

  // @PortField{side: right}
  List<CollectorGroup> groups = 4; // 收集器组
  // @PortField{side: right}
  IIgnoreService ignoreService = 5; // 忽略规则    
}
inst CollectorPackage {
  packageName: Default,
  packageVersion: "0.0.0",
}

// 构建管线 - ds文件中直接继承Task类，以屏蔽children属性
class BuildPipelineTask : Task<Blackboard> {
  EBuildTarget buildTarget = 1; // 构建目标
  ECompression compression = 2; // 压缩方式
  bool useAssetDependencyDB = 3; // 是否启用缓存db
  
  // @PortField{side: bottom}
  List<Task<Blackboard>> preBuildTasks = 6; // 构建前任务
  // @PortField{side: bottom}
  List<Task<Blackboard>> buildTasks = 7; // 构建任务
  // @PortField{side: bottom}
  List<Task<Blackboard>> postBuildTasks = 8; // 构建后任务
}

// 包构建器入口
class PackageBuilder {
  // @PortField{side: right}
  CollectorPackage package = 1;
  // @PortField{side: right}
  BuildPipelineTask buildTask = 2;
}

// 构建依赖任务
class BuildDependencyTask : Task<Blackboard> {
  bool autoIgnoreLibrary = 1; // 是否自动忽略第三方程序集
}
inst BuildDependencyTask {
  autoIgnoreLibrary: true
}

// 构建索引任务
class BuildIndexesTask : Task<Blackboard> {
  bool reportLog = 1; // 是否上报详细日志到独立文件
  //@Editor {displayType: AssetPath}
  string reportPath = 2; // 日志文件路径
  HashSet<string> supportExtensions = 3; // 支持无扩展名索引的文件类型
}
inst BuildIndexesTask {
  reportLog: true,
  reportPath: "Assets/Editor/IndexReport.log",
  supportExtensions: [fbx, prefab, asset, png, jpg, tif, ogg, wav, mp3]
}

// 编辑器下的构建任务
class EditorBuildTask : Task<Blackboard> {
  //@Editor {displayType: AssetPath}
  string binFilePath = 1;
  //@Editor {displayType: AssetPath}
  string textFilePath = 2; 
}
// 图片分类器
class SpriteClassifier {
}
// 音频分类器
class AudioClassifier {
}
// 配置分类器(原始文件)
class ConfigClassifier {
  HashSet<string> rawFileExtensions = 1;    // 原始文件扩展名
  HashSet<string> ignoreFileExtensions = 2; // 忽略文件扩展名
}

// 导入SearchWindow
// @SearchTreeGroupEntry {}
class SearchTreeGroupEntry : BTreeSearchTreeGroupEntry0<Blackboard> {
  Collector = 1;
  CollectorGroup = 2;
  CollectorPackage = 3;
  BuildPipelineTask = 4;
  PackageBuilder = 5; //@Editor{nodeFeatures: "Executable | EnablePort" }
  EditorBuildTask = 6;
  BuildDependencyTask = 7;
  BuildIndexesTask = 8;

  SpriteClassifier = 11;
  AudioClassifier = 12;
  ConfigClassifier = 13;
}