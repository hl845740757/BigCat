// 技能配置文件示例
import public "common.ds";
import public "btree.ds";
import public "animator.ds";

// 工具库的黑板类型，避免导出给其它ds文件
// @Namespace{ cs: "Wjybxx.BigCat.Util", nonGenerate: true }
class Blackboard  {
}

// 伤害/受击类型
enum HurtType {
    Normal = 0; // 普通(默认)
    SuperArmor = 1; // 霸体
    Invincible = 2; // 无敌
}
// 攻击类型
enum AttackType {
    Physic = 1; // 物理攻击
    Magic = 2; // 魔法攻击
    spirit = 3; // 精神攻击(beta)
}
// 元素类型
enum ElementType {
    None = 0;
    Ice = 1; // 冰
    Fire = 2; // 火
    Light = 3; // 光
    Dark = 4; // 暗
}
// 目标筛选形状类型
enum ShapeType {
    Self = 0; // 施法者自身
    SelfTeam = 1; // 己方队伍 - 可填距离限制
    Target = 2; // 输入的目标对象(技能当前目标)
    TargetTeam = 3; // 目标单位队伍
    //
    AttackBoxes = 4; // 自身攻击盒 - 最常用
    HurtBoxes = 5; // 自身受击盒 - 不常用
    Sphere = 6; // 球，测试XYZ
    Cube = 7; // Cube，测试XYZ
    Cylinder = 8; // 圆柱，测试XZ坐标 + 高度差
}
// 阵营关系
enum RelationType {
    Unknown = 0; // 未知，不匹配任何关系条件
    Enemy = 1; // 敌人
    Friend = 2; // 友方
    Neutral = 3; // 中立
}

// 一些内置Action

// 播放音效
class PlaySound {
  ObjectPath audioPath = 1; // 音效地址
  float volume = 2; // 音量
}
inst PlaySound {
  audioPath: {@ptr type: 3}, // 音效组类型
  volume: 1,
}
// 播放音乐
class PlayMusic {
  // @Editor{displayType: AssetPath}
  string audioPath = 1; // 音效地址
  bool loop = 2; // 是否循环
  float fadeInTime = 3; // 淡入时间
  float fadeOutTime = 4; // 淡出时间  
}

// 这里将所有类型引用进来，通过子类实例化泛型
class SkillGroupEntry0<T> : BTreeSearchTreeGroupEntry0<T> {

}
// 通过子类直接实例化所有泛型
// @SearchTreeGroupEntry {}
class SkillGroupEntry : SkillGroupEntry0<Blackboard> {
  PlaySound _f1 = 1;
  PlayMusic _f2 = 2;
}