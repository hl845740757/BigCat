// 角色动画
import public "common.ds";
import public "btree.ds";

// 文件选项
inst @file {
  macro_types: [region, endregion],
  csharp_namespace: "Wjybxx.BigCat.Dnf.Trigger"
}

// ---------------------------------------------------------
// 工具库的黑板类型，避免导出给其它ds文件
// @Options{nonGenerate: true}
// @Namespace{cs: "Wjybxx.BigCat.Util"}
class Blackboard {
}

// 动画环绕模式
// @Namespace{cs: "Wjybxx.BigCat.Animator"}
enum EWrapMode {
  StopAtEnd = 0;
  Loop = 1;
  PingPong = 2;
  Clamp = 3;
}
// 动画播放选项
// @Options{isFlags: true}
// @Namespace{cs: "Wjybxx.BigCat.Animator"}
enum AnimationOptions {
  None = 0;
  EnableOffset = 0x01; // 启用偏移
  EnableRange = 0x02; // 启用区间
  EnableShadow = 0x04; // 启用阴影
  EnableSortOrder = 0x08; // 启用动画层级
  ReservedMotion = 0x10; // 保留动作配置
  FlipX = 0x20; // X轴翻转
  FlipY = 0x40; // Y轴翻转  
}
// 动画播放请求
// @Namespace{cs: "Wjybxx.BigCat.Animator"}
struct AnimationRequest {
  //@Editor{displayType: AssetPath}
  string clipPath = 1; // 播放的动画
  EWrapMode wrapMode = 2; // 动画播放模式
  int32 startFrame = 3; // 开始帧
  int32 endFrame = 4; // 结束帧
  Vector2 offset = 5; // 动画偏移
  AnimationOptions options = 6; // 播放选项
}

// 导入SearchWindow
// @SearchTreeGroupEntry {}
class SearchTreeGroupEntry {
  AnimationRequest = 1; // @Editor {nodeFeatures: "Inlinable | EnablePort | ImplicitType"}
}