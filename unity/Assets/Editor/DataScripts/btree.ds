// 行为树节点
import public "common.ds";

// 文件选项
option {
  macro_types: [region, endregion],
  csharp_namespace: "Wjybxx.BTree"
}

// ---------------------------------------------------------
// 行为树编辑器配置文件，行为树实现模块见BTree.Core
// 行为树基类
class Task<T> {
  string name = 1;
  // @PortField{side: left}
  Task<T> guard = 2; // 条件节点
  int32 flags = 3; // 自定义特征值
} 

// 分支节点基类
class BranchTask<T> : Task<T> {
  // @PortField{side: bottom, distinct : true, expanded: true}
  List<Task<T>> children = 1;
}
// 装饰器基类
class Decorator<T> : Task<T> {
  // @PortField{side: bottom}
  Task<T> child = 1;
}
// 叶子节点基类
class LeafTask<T> : Task<T> {
}

// ------------------------------------------
// 子树引用
// @Namespace{cs: "Wjybxx.BTree.Decorator"}
class SubtreeRef<T> : Decorator<T> {
  // @PortField{side: right}
  ObjectPath path = 1; // 可直接连线
}
// 每帧检查任务的前置条件
// @Namespace{cs: "Wjybxx.BTree.Decorator"}
class AlwaysCheckGuard<T> : Decorator<T> {
}
// 子任务完成后返回失败
// @Namespace{cs: "Wjybxx.BTree.Decorator"}
class AlwaysFail<T> : Decorator<T> {
  int32 failureStatus = 1; // 错误码
}
// 子任务完成后返回成功
// @Namespace{cs: "Wjybxx.BTree.Decorator"}
class AlwaysSuccess<T> : Decorator<T> {
}
// 保持运行状态
// @Namespace{cs: "Wjybxx.BTree.Decorator"}
class AlwaysRunning<T> : Decorator<T> {
}
// 反转子节点的执行结果
// @Namespace{cs: "Wjybxx.BTree.Decorator"}
class Inverter<T> : Decorator<T> {
}

// 重复N次
// @Namespace{cs: "Wjybxx.BTree.Decorator"}
class Repeat<T> : Decorator<T> {
  // @PopField {value: 0, displayName: Always}
  // @PopField {value: 1, displayName: OnlySuccess}
  // @PopField {value: 2, displayName: OnlyFailed}
  // @PopField {value: 3, displayName: Never}
  int32 countMode = 1;
  int32 required = 2;
}
inst Repeat {
  required: 1
}
// 直到运行成功
// @Namespace{cs: "Wjybxx.BTree.Decorator"}
class UntilSuccess<T> : Decorator<T> {
}
// 直到运行失败
// @Namespace{cs: "Wjybxx.BTree.Decorator"}
class UntilFail<T> : Decorator<T> {
}
// 直到指定条件达成
// @Namespace{cs: "Wjybxx.BTree.Decorator"}
class UntilCond<T> : Decorator<T> {
  // @PortField{}
  Task<T> cond = 1;
}
// 只执行一次，除非手动调用Reset
// @Namespace{cs: "Wjybxx.BTree.Decorator"}
class OnlyOnce<T> : Decorator<T> {
}

// ------------------------------------------
// FSM
// @Namespace{cs: "Wjybxx.BTree.FSM"}
class StateMachineTask<T> : Decorator<T> {
  // @PortField{side: right, distinct : true}
  List<Task<T>> stateList = 1; // 状态列表
}
// 切换状态
// @Namespace{cs: "Wjybxx.BTree.FSM"}
class ChangeStateTask<T> : LeafTask<T> {
  // @PortField{side: right}
  Task<T> nextState = 1; // 下一个状态
  // @PortField{side: right}
  Object stateProps = 2; // 状态附加数据
  
  string machineName = 3; // 目标状态机名，可空
  int32 delayMode = 4; // 延迟模式，建议保持0
  
  // @PopField {value: 2, displayName: "Success"}
  // @PopField {value: 3, displayName: "Cancelled"}
  // @PopField {value: 4, displayName: "Failed"}
  int32 delayArg = 5; // 延迟参数；不延迟时，表示FSM当前状态的执行结果
}
// 切换状态
// @Namespace{cs: "Wjybxx.BTree.FSM"}
class ChangeStateTask2<T> : LeafTask<T> {
  string stateName = 1; // 下一个状态的name
  
  string machineName = 3; // 目标状态机名，可空
  int32 delayMode = 4; // 延迟模式，建议保持0
  
  // @PopField {value: 2, displayName: "Success"}
  // @PopField {value: 3, displayName: "Cancelled"}
  // @PopField {value: 4, displayName: "Failed"}
  int32 delayArg = 5; // 延迟参数；不延迟时，表示FSM当前状态的执行结果
}

// ------------------------------------------
// 选择执行 - OR
// @Namespace{cs: "Wjybxx.BTree.Branch"}
class Selector<T> : BranchTask<T> {
}
// 顺序执行 - AND
// @Namespace{cs: "Wjybxx.BTree.Branch"}
class Sequence<T> : BranchTask<T> {
}
// 根据子节点的前置条件选择要执行的节点
// @Namespace{cs: "Wjybxx.BTree.Branch"}
class Switch<T> : BranchTask<T> {
}
// 所有子节点执行完成之后返回成功
// @Namespace{cs: "Wjybxx.BTree.Branch"}
class Foreach<T> : BranchTask<T> {
}
// 每帧重新选择要执行的节点
// @Namespace{cs: "Wjybxx.BTree.Branch"}
class ActiveSelector<T> : BranchTask<T> {
}
// N个子节点成功时返回成功
// @Namespace{cs: "Wjybxx.BTree.Branch"}
class SelectorN<T> : BranchTask<T> {
  int32 required = 1; // 需要成功的数量
  bool failFast = 2; // 是否快速失败，不等执行完毕
}

// ----------------------------------------
// 简单并行节点
// @Namespace{cs: "Wjybxx.BTree.Branch"}
class SimpleParallel<T> : BranchTask<T> {
}
// Join并行节点
// @Namespace{cs: "Wjybxx.BTree.Branch"}
class Join<T> : BranchTask<T> {
  // @Editor{initNull: true}
  // @PloyField["JoinMain<T>", "JoinSelector<T>", "JoinSequence<T>", "JoinAnyOf<T>", "JoinWaitAll<T>"]
  JoinPolicy<T> policy = 1; // 调度策略，多态字段
}

// 调度策略接口
// @Namespace{cs: "Wjybxx.BTree.Branch"}
class JoinPolicy<T> {
}
class JoinMain<T> : JoinPolicy<T> {
}
class JoinSelector<T> : JoinPolicy<T> {
}
class JoinSequence<T> : JoinPolicy<T> {
}
class JoinAnyOf<T> : JoinPolicy<T> {
}
class JoinWaitAll<T> : JoinPolicy<T> {
}

// --------------------------------------
// 保持运行
// @Namespace{cs: "Wjybxx.BTree.Leaf"}
class Running<T> : LeafTask<T> {
}
// 返回成功
// @Namespace{cs: "Wjybxx.BTree.Leaf"}
class Success<T> : LeafTask<T> {
}
// 返回失败
// @Namespace{cs: "Wjybxx.BTree.Leaf"}
class Failure<T> : LeafTask<T> {
  int32 failureStatus = 1; // 错误码
}

// 简单随机节点
// @Namespace{cs: "Wjybxx.BTree.Leaf"}
class SimpleRandom<T> : LeafTask<T> {
  float p = 1; // 概率
}
// 简单等待N帧
// @Namespace{cs: "Wjybxx.BTree.Leaf"}
class SimpleWaitFrame<T> : LeafTask<T> {
  int32 required = 1; // 需要等待的帧数
}

// -------------------------------------
// 这里将所有类型引用进来，通过子类实例化泛型
class BTreeSearchTreeGroupEntry0<T> {
  SubtreeRef<T> = 1;
  AlwaysCheckGuard<T> = 2;
  AlwaysFail<T> = 3;
  AlwaysSuccess<T> = 4;
  AlwaysRunning<T> = 5;
  Inverter<T> = 6;
  
  StateMachineTask<T> = 7;
  ChangeStateTask<T> = 8;
  ChangeStateTask2<T> = 9;
  
  Selector<T> = 11;
  Sequence<T> = 12;
  Switch<T> = 13;
  Foreach<T> = 14;
  ActiveSelector<T> =15;
  SelectorN<T> = 16;
  
  SimpleParallel<T> = 21;
  Join<T> = 22;
  JoinMain<T> = 23;
  JoinSelector<T> = 24;
  JoinSequence<T> = 25;
  JoinAnyOf<T> = 26;
  JoinWaitAll<T> = 27;
  
  Running<T> = 31;
  Success<T> = 32;
  Failure<T> = 33;
  SimpleRandom<T> = 34;
  SimpleWaitFrame<T> = 35;
  
  Repeat<T> = 41;
  UntilSuccess<T> = 42;
  UntilFail<T> = 43;
  UntilCond<T> = 44;
  OnlyOnce<T> = 45;
}
// 通过子类直接实例化所有泛型
