<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" uibigcat="Wjybxx.BigCat.CoreEditor.UIElements" editor-extension-mode="True">
    <Wjybxx.BigCat.CoreEditor.UIElements.ObjectPathField name="object-content" style="justify-content: flex-start; align-items: stretch; min-width: auto; flex-direction: column; flex-wrap: nowrap; flex-shrink: 0;">
        <ui:Foldout text="ObjectPath" value="true" name="foldout" style="flex-shrink: 0; flex-grow: 1;">
            <ui:VisualElement style="justify-content: space-between; flex-shrink: 0; flex-direction: row;">
                <ui:TextField picking-mode="Ignore" label="AssetPath" tooltip="资产文件路径" name="collection" multiline="false" style="min-width: 300px; flex-grow: 1;" />
                <ui:Button text="选择" display-tooltip-when-elided="true" name="select-collection" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; flex-shrink: 0;">
                <ui:TextField picking-mode="Ignore" label="LocalPath" name="local-path" tooltip="对象在资产内的相对路径" style="height: auto; min-width: 300px; flex-grow: 1;" />
                <ui:Button text="选择" display-tooltip-when-elided="true" name="select-local-path" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; flex-shrink: 0; flex-grow: 0;">
                <uie:LongField label="LocalId" value="10001" name="local-id" tooltip="对象在资产内的ID" style="min-width: 300px; flex-grow: 1;" />
                <ui:Button text="选择" display-tooltip-when-elided="true" name="select-local-id" />
            </ui:VisualElement>
            <ui:VisualElement style="flex-direction: row; justify-content: space-between; flex-shrink: 0; flex-grow: 0;">
                <uie:IntegerField label="AssetType" value="0" name="type" tooltip="资产类型" is-delayed="true" readonly="false" style="flex-grow: 1;" />
                <ui:Toggle label="锁定" name="lock-type" value="true" style="flex-direction: row-reverse; align-items: stretch; justify-content: flex-end; flex-wrap: nowrap; transform-origin: center; height: auto; width: 40px;" />
            </ui:VisualElement>
        </ui:Foldout>
    </Wjybxx.BigCat.CoreEditor.UIElements.ObjectPathField>
</ui:UXML>
